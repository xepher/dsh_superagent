@page
@model IndexModel
@{
    ViewData["Title"] = "概览";
    ViewData["Subtitle"] = "先看需要人处理的事，再看系统是否在做正确的事。";

    string StageLabel(string stage) => stage switch
    {
        "PersonDelivery" => "输入投递失败",
        "PersonAnswer" => "等待回答",
        "PersonReview" => "等待复核",
        "PersonBlocked" => "受阻",
        "PersonFailed" => "失败",
        "WorkingQueued" => "排队中",
        "Idle" => "等待触发",
        "Working" => "执行中",
        "Ended" => "已结束",
        _ => stage,
    };
    string StageBadge(string stage) => stage switch
    {
        "PersonReview" => "warning",
        "PersonBlocked" or "PersonFailed" or "PersonDelivery" => "danger",
        "Working" => "info",
        "Idle" => "neutral",
        "Ended" => "neutral",
        _ => "teal",
    };
}

<div class="stats">
    <div class="stat accent">
        <div class="stat-label">24h Trigger / Eval</div>
        <div class="stat-value">@Model.Triggers24h / @Model.Evals24h</div>
        <div class="stat-foot">Source 记录的事件与研判次数</div>
    </div>
    <div class="stat teal">
        <div class="stat-label">开放工单</div>
        <div class="stat-value">@Model.OpenTickets</div>
        <div class="stat-foot">运行中的 Assignment：@Model.RunningAssignments</div>
    </div>
    <div class="stat amber">
        <div class="stat-label">需要人处理</div>
        <div class="stat-value">@Model.NeedsPerson.Count</div>
        <div class="stat-foot">按等待时间从长到短</div>
    </div>
    <div class="stat rose">
        <div class="stat-label">系统问题</div>
        <div class="stat-value">@(Model.UnavailableEvals + Model.FailedMessages)</div>
        <div class="stat-foot">Unavailable Eval @Model.UnavailableEvals · 失败消息 @Model.FailedMessages</div>
    </div>
</div>

<div class="grid-2">
    <section class="card">
        <div class="card-header">
            <div>
                <h2>需要你</h2>
                <p>工单停在需要人决策、复核或修复的状态。</p>
            </div>
            <a class="btn small" asp-page="/Admin/Tickets/Index">全部工单</a>
        </div>
        @if (Model.NeedsPerson.Count == 0)
        {
            <div class="empty">
                <div class="mark">✓</div>
                <strong>现在没有需要你处理的事</strong>
                <p>健康的系统不占用注意力。新的请求、审查或修复会出现在这里。</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr><th>工单</th><th>状态</th><th>类型</th><th>更新时间</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var ticket in Model.NeedsPerson)
                    {
                        <tr>
                            <td>
                                <a class="cell-title" asp-page="/Admin/Tickets/Detail" asp-route-id="@ticket.Id">@ticket.Title</a>
                                <div class="cell-sub mono">@ticket.Id.ToString("N")[..8]</div>
                            </td>
                            <td><span class="badge @StageBadge(ticket.Stage)">@StageLabel(ticket.Stage)</span></td>
                            <td>@(ticket.WorkKind == "Fix" ? "修复" : "问答")</td>
                            <td class="muted nowrap">@ticket.At.ToLocalTime().ToString("MM-dd HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-header">
            <div>
                <h2>配置检查</h2>
                <p>缺一项就会在对应位置挡住工作。</p>
            </div>
        </div>
        <div class="checklist">
            <a class="checklist-item @(Model.EnabledSources > 0 ? "ok" : "todo")" asp-page="/Admin/Sources/Index">
                <span class="icon">@(Model.EnabledSources > 0 ? "✓" : "!")</span>
                <span><strong>消息 Source</strong><span>@Model.EnabledSources 个启用，@Model.AllowedUsers 个允许用户</span></span>
            </a>
            <a class="checklist-item @(Model.EnabledRepositories > 0 ? "ok" : "todo")" asp-page="/Admin/Repositories/Index">
                <span class="icon">@(Model.EnabledRepositories > 0 ? "✓" : "!")</span>
                <span><strong>代码仓库</strong><span>@Model.EnabledRepositories 个启用；@(Model.HasAutoReview ? "已开启定时审查" : "尚未开启定时审查")</span></span>
            </a>
            <a class="checklist-item @(Model.HasModel ? "ok" : "todo")" asp-page="/Admin/Models/Index">
                <span class="icon">@(Model.HasModel ? "✓" : "!")</span>
                <span><strong>模型服务</strong><span>@(Model.HasModel ? "已配置默认模型" : "未配置；问答会降级为本地检索，推断候选无法研判")</span></span>
            </a>
            <a class="checklist-item @(Model.HasPullRequest ? "ok" : "todo")" asp-page="/Admin/PullRequests/Index">
                <span class="icon">@(Model.HasPullRequest ? "✓" : "!")</span>
                <span><strong>PR Provider</strong><span>@(Model.HasPullRequest ? "已配置，默认 dry-run 需自行关闭" : "未配置；修复只保存补丁，不创建 PR")</span></span>
            </a>
            <a class="checklist-item @(Model.AcceptMode == DshSuperagent.Domain.Sources.AcceptMode.Auto ? "ok" : "todo")" asp-page="/Admin/Policy/Index">
                <span class="icon">@(Model.AcceptMode == DshSuperagent.Domain.Sources.AcceptMode.Auto ? "✓" : "!")</span>
                <span><strong>Policy v@(Model.PolicyVersion)</strong><span>accept mode <code>@Model.AcceptMode</code>@(Model.AcceptMode == DshSuperagent.Domain.Sources.AcceptMode.Observe ? "：推断候选只记录，不自动接单" : "")</span></span>
            </a>
        </div>
        <div class="callout" style="margin-top:16px">
            先让自动审查在 <code>observe</code> 下跑一段时间，查看“本可接单”的 Decision，再切到 <code>auto</code>。
        </div>
    </section>
</div>

<div class="grid-2">
    <section class="card tight">
        <div class="card-header" style="padding:20px 22px 0">
            <div><h2>最近的 Eval</h2><p>研判为什么接单、忽略或停止。</p></div>
            <a class="btn small" asp-page="/Admin/Evals/Index">全部</a>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>决定</th><th>状态</th><th>理由</th><th>Policy</th></tr></thead>
                <tbody>
                @foreach (var eval in Model.RecentEvals)
                {
                    <tr>
                        <td><span class="badge @(eval.Decision == "Accept" ? "success" : eval.Decision == "Stop" ? "danger" : "neutral")">@eval.Decision</span></td>
                        <td class="muted">@eval.Status</td>
                        <td>@(eval.Reason ?? "—")</td>
                        <td class="mono">v@eval.PolicyVersion</td>
                    </tr>
                }
                @if (Model.RecentEvals.Count == 0)
                {
                    <tr><td colspan="4" class="muted">还没有 Eval。</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card tight">
        <div class="card-header" style="padding:20px 22px 0">
            <div><h2>最近活动</h2><p>领域事件与投递记录。</p></div>
        </div>
        <div class="table-wrap">
            <table class="table">
                <tbody>
                @foreach (var audit in Model.RecentAudit)
                {
                    <tr>
                        <td class="mono muted nowrap">@audit.At.ToLocalTime().ToString("HH:mm")</td>
                        <td><span class="badge neutral">@audit.Category</span></td>
                        <td>@audit.Summary</td>
                    </tr>
                }
                @if (Model.RecentAudit.Count == 0)
                {
                    <tr><td class="muted">还没有活动。</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<section class="card">
    <div class="card-header">
        <div>
            <h2>最近工单</h2>
            <p>每个工单都有 Mandate，记录它凭什么可以工作。</p>
        </div>
        <div class="page-actions">
            <a class="btn small" asp-page="/Admin/Concepts/Index">领域模型说明</a>
            <a class="btn small primary" asp-page="/Admin/Threads/Index">查看 Thread</a>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>标题</th><th>类型</th><th>阶段</th><th>创建时间</th></tr></thead>
            <tbody>
            @foreach (var ticket in Model.RecentTickets)
            {
                <tr>
                    <td><a class="cell-title" asp-page="/Admin/Tickets/Detail" asp-route-id="@ticket.Id">@ticket.Title</a></td>
                    <td>@(ticket.WorkKind == "Fix" ? "修复" : "问答")</td>
                    <td><span class="badge @StageBadge(ticket.Stage)">@StageLabel(ticket.Stage)</span></td>
                    <td class="muted nowrap">@ticket.At.ToLocalTime().ToString("MM-dd HH:mm")</td>
                </tr>
            }
            @if (Model.RecentTickets.Count == 0)
            {
                <tr><td colspan="4" class="muted">还没有工单。在群里 @@机器人 问一个代码问题，或点「立即扫描」。</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
